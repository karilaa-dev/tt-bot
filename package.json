{
  "name": "tt-bot",
  "version": "6.0.3",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "start": "bun run scripts/start.ts",
    "dev": "bun --watch --no-clear-screen run src/main.ts",
    "maintenance": "bun run src/maintenance.ts",
    "db:migrate-legacy": "bun run scripts/migrate-legacy.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration:migration": "RUN_POSTGRES_MIGRATION_INTEGRATION=1 bun test tests/integration/legacy-migration.integration.test.ts",
    "test:integration:tt-scrap": "RUN_TT_SCRAP_INTEGRATION=1 bun test tests/integration/tt-scrap.integration.test.ts",
    "api:generate": "bun run scripts/generate-tt-scrap-types.ts"
  },
  "dependencies": {
    "@grammyjs/runner": "2.0.3",
    "grammy": "1.45.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "openapi-typescript": "7.13.0",
    "typescript-openapi": "npm:typescript@5.9.3",
    "typescript": "7.0.2"
  }
}
