# Telegram bot
BOT_TOKEN=12345:replace-with-bot-token
# ADMIN_IDS=[]
# Numeric Telegram chat IDs only. Username targets such as @channel are rejected.
# JOIN_LOGS=0
# STORAGE_CHANNEL_ID=0

# Public Telegram Bot API is the default. A custom server remains optional.
# TG_SERVER=https://api.telegram.org
# TG_SERVER=http://telegram-bot-api.example:8081

# tt-scrap defaults to localhost when the bot runs directly on the host.
# Docker Compose defaults this to http://host.docker.internal:8000 instead.
# TT_SCRAP_BASE_URL=http://127.0.0.1:8000
TT_SCRAP_API_KEY=replace-with-at-least-16-characters
# TT_SCRAP_REQUEST_TIMEOUT_SECONDS=90
# TT_SCRAP_DELIVERY_TIMEOUT_SECONDS=620

# PostgreSQL managed by Docker Compose
DB_URL=postgresql://postgres:postgres@db:5432/ttbot-db
# DB_POOL_SIZE=10

# Dokploy: after verifying the backup, set this to "confirmed" for one
# deployment. The container installs live-write sync, starts the bot, and
# backfills history in the background. Remove it after the migration succeeds.
# MIGRATE_LEGACY_ON_START=confirmed
# Optional extra safety check when the database host's exact free bytes are known:
# LEGACY_MIGRATION_AVAILABLE_BYTES=30000000000

# The active extraction counts toward these FIFO queue capacities.
# MAX_USER_QUEUE_SIZE=3
# MAX_GROUP_QUEUE_SIZE=10
# MAX_ACTIVE_JOBS=25
# LOG_LEVEL=INFO
